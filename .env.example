# HeyGen AI Video Generation API
HEYGEN_API_KEY=your_heygen_api_key_here

# ImobTotal CRM API
IMOBTOTAL_API_KEY=your_imobtotal_api_key_here
IMOBTOTAL_BASE_URL=https://app.imobtotal.com.br/api/v1

# Cloudflare R2 / S3 Object Storage
S3_REGION=auto
S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key_id_here
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
S3_BUCKET=your_bucket_name
S3_PUBLIC_URL_PREFIX=https://pub-your_bucket_id.r2.dev

# Servidor
PORT=3005

# PostgreSQL Database (Video Jobs & Persistence)
PGHOST=localhost
PGPORT=5432
PGDATABASE=bali_gestor
PGUSER=your_db_user
PGPASSWORD=your_db_password