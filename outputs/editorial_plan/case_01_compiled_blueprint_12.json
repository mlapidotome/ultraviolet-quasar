  "captions": [
    {
      "start_ms": 0,
      "end_ms": 2146,
      "text": "Por que continuar pagando aluguel se você"
    },
    {
      "start_ms": 2146,
      "end_ms": 4292,
      "text": "pode morar a minutos do Taubaté Shopping e do"
    },
    {
      "start_ms": 4292,
      "end_ms": 6440,
      "text": "Shibata pagando parcelas de R$2.000?"
    },
    {
      "start_ms": 6440,
      "end_ms": 8100,
      "text": "Dá uma olhada nesse apartamento de R$350.000"
    },
    {
      "start_ms": 8100,
      "end_ms": 9760,
      "text": "no Residencial Júlia."
    },
    {
      "start_ms": 9760,
      "end_ms": 12239,
      "text": "A localização é perfeita para o dia a dia."
    },
    {
      "start_ms": 12239,
      "end_ms": 13979,
      "text": "Você estará a poucos minutos do Taubaté"
    },
    {
      "start_ms": 13979,
      "end_ms": 15719,
      "text": "Shopping, coladinho ao supermercado Shibata e"
    },
    {
      "start_ms": 15719,
      "end_ms": 17459,
      "text": "com acesso ultra rápido à Dutra e Carvalho"
    },
    {
      "start_ms": 17459,
      "end_ms": 19200,
      "text": "Pinto."
    },
    {
      "start_ms": 19200,
      "end_ms": 21260,
      "text": "O apartamento tem 68m² muito bem planejados:"
    },
    {
      "start_ms": 21260,
      "end_ms": 23320,
      "text": "sala espaçosa, cozinha funcional, dois"
    },
    {
      "start_ms": 23320,
      "end_ms": 25380,
      "text": "banheiros, dois dormitórios sendo uma suíte"
    },
    {
      "start_ms": 25380,
      "end_ms": 27440,
      "text": "privativa."
    },
    {
      "start_ms": 27440,
      "end_ms": 28893,
      "text": "E o destaque especial: uma varanda deliciosa"
    },
    {
      "start_ms": 28893,
      "end_ms": 30346,
      "text": "com churrasqueira para curtir o fim de"
    },
    {
      "start_ms": 30346,
      "end_ms": 31799,
      "text": "semana."
    },
    {
      "start_ms": 31799,
      "end_ms": 33546,
      "text": "O condomínio conta com portaria remota 24h,"
    },
    {
      "start_ms": 33546,
      "end_ms": 35293,
      "text": "salão de festas, área gourmet, playground e"
    },
    {
      "start_ms": 35293,
      "end_ms": 37040,
      "text": "vaga coberta."
    },
    {
      "start_ms": 37040,
      "end_ms": 38950,
      "text": "Tudo isso por apenas R$350.000, financiado"
    },
    {
      "start_ms": 38950,
      "end_ms": 40860,
      "text": "pelo Minha Casa Minha Vida, com entrada em"
    },
    {
      "start_ms": 40860,
      "end_ms": 42770,
      "text": "torno de R$60.000 a R$70.000 e parcelas na"
    },
    {
      "start_ms": 42770,
      "end_ms": 44680,
      "text": "faixa de R$2.000."
    },
    {
      "start_ms": 44680,
      "end_ms": 47040,
      "text": "E aí, gostou dessa oportunidade?"
    },
    {
      "start_ms": 47040,
      "end_ms": 48920,
      "text": "Faz o seguinte: clica no botão Saiba Mais,"
    },
    {
      "start_ms": 48920,
      "end_ms": 50800,
      "text": "deixe o seu melhor telefone que a nossa"
    },
    {
      "start_ms": 50800,
      "end_ms": 52680,
      "text": "equipe vai te chamar e agendar uma visita."
    }
  ],
