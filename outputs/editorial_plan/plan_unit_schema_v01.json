{
  "schema_id": "SCHEMA_EDITORIAL_PLAN_UNIT_V01",
  "title": "Editorial Plan Unit Schema",
  "description": "Canonical data contract representing a single planned beat on timeline, translating creative decisions into semantic temporal intent.",
  "epistemic_status": "QUALITATIVE_SCHEMA_CANDIDATE",
  "currently_binding": false,
  "fields": {
    "plan_unit_id": "string (e.g. PLAN_UNIT_01)",
    "beat_id": "string (e.g. BEAT_01)",
    "time_range_source": "string (e.g. 00:00.000 - 00:06.440)",
    "script_excerpt": "string",
    "ground_truth_reference": "object with source, authority, and locked flag",
    "creative_decision_reference": "string (decision_id from CDM)",
    "narrative_functions": "array of canonical strings",
    "subjects": "array of strings",
    "viewer_effects": "array of strings",
    "state_decision": "HOLD | EVOLVE | SWITCH",
    "primary_visual_strategy": "string",
    "source_strategy": "PRESENTER | PROPERTY | LOCATION | INFORMATION | LIFESTYLE | CONTEXT | MIXED | CURRENT_STATE | UNRESOLVED",
    "media_intent": "array of strings from taxonomy",
    "continuity_intent": "array of strings from taxonomy",
    "composition_intent": "array of strings from taxonomy",
    "graphic_intent": "string from taxonomy",
    "typography_intent": "object adhering to typography schema",
    "information_intent": "object adhering to information schema",
    "transition_intent": "string from taxonomy",
    "audio_intent": "array of strings from taxonomy",
    "motion_intent": "string from taxonomy",
    "emphasis_intent": "object with importance, target, and intensity",
    "attention_intent": "object with load, focus_target, and breathing_room",
    "performance_preservation_intent": "LOW | MEDIUM | HIGH | CRITICAL",
    "visual_payoff_intent": "NONE | PENDING | FULFILLED",
    "location_evidence_intent": "NONE | CONTEXTUAL | VERIFIED_EVIDENCE_REQUIRED",
    "candidate_technique_refs": "array of Technique IDs",
    "selected_technique_refs": "array of Technique IDs",
    "asset_requirements": "array of asset requirement objects",
    "unresolved_requirements": "array of unresolved requirement strings",
    "constraints": "array of constraint strings",
    "confidence": "HIGH | MEDIUM | LOW",
    "uncertainties": "array of uncertainty notes",
    "editorial_summary": "human-readable editorial summary of desired timeline result"
  }
}