      const originalText = btnEl.innerText;
      btnEl.innerText = "Salvando...";
      btnEl.disabled = true;

      try {
        const res = await fetch('/api/acompanhamentos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ leadId, funilId, resumo, proxima_acao, previsao, situacao, data_reuniao, encaminhamento_pauta })
        });
        
