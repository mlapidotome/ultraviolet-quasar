          const btn = document.getElementById('btn-sync-phones');
          if (btn) btn.disabled = true;
          
          let totais_salvos = 0;
          let totais_reqs = 0;
          
          try {
              for (const funil of funis) {
                  let pagAtual = 1;
                  let totalPags = 1;
                  
                  while (pagAtual <= totalPags) {
                      if (btn) btn.innerText = `Funil ${funil} - Pág ${pagAtual}/${totalPags > 1 ? totalPags : '?'}`;
                      
                      const res = await fetch('/api/phones/sync-page', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({ funil_id: funil, pagina: pagAtual })
                      });
                      
                      if (!res.ok) throw new Error('Erro na requisição');
                      
                      const data = await res.json();
                      totais_reqs++;
                      
                      if (data.total_paginas) totalPags = data.total_paginas;
                      totais_salvos += data.salvos_nesta_pagina || 0;
                      
                      pagAtual++;
                  }
              }
              alert(`Sincronização concluída!\nRequisições feitas: ${totais_reqs}\nNovos telefones salvos/confirmados: ${totais_salvos}`);
              await carregarTelefones();
              renderCardsTable(true);
          } catch(e) {
              alert('Erro na sincronização: ' + e.message);
          } finally {
              if (btn) {
                  btn.disabled = false;
                  btn.innerText = 'Sincronizar Telefones';
              }
          }
      }

      function exportToExcel() {
          if (!uiState.filteredCards || uiState.filteredCards.length === 0) {
              alert('Nenhum card para exportar com os filtros atuais.');
              return;
          }
          
          const uniqueClients = new Set(uiState.filteredCards.map(c => c.lead_id)).size;
          if (!confirm(`Você exportará ${uiState.filteredCards.length} cards de ${uniqueClients} clientes únicos. Confirmar?`)) return;
          
          const rows = [];
          
          uiState.filteredCards.forEach(c => {
              const telRaw = telefones_cache[String(c.lead_id)] || telefones_cache[c.lead_id];
              const telVal = telRaw ? String(telRaw) : 'Telefone não disponível';
              
              const keyAcomp = `${c.lead_id}_${c.funil_id}`;
              const acompData = (currentData.acompanhamentos || {})[keyAcomp] || {};
              const atual = acompData.atual || {};
              const isMarked = !!uiState.agenda[keyAcomp];
              
              const resumoStatus = (currentData.cache_resumo[c.lead_id] || {}).status;
              let sitComentarios = 'Não verificado';
              if (resumoStatus === 'com_comentarios') sitComentarios = 'Com comentários';
              else if (resumoStatus === 'sem_comentarios') sitComentarios = 'Sem comentários';
              else if (resumoStatus === 'expirado') sitComentarios = 'Consulta expirada';
              
              const dataUltimo = (c.data_ultimo_atendimento && c.data_ultimo_atendimento !== 'null') 
                  ? new Date(c.data_ultimo_atendimento).toLocaleDateString() 
                  : 'Não registrado';
              
              const prazoFormatado = atual.previsao ? new Date(atual.previsao).toLocaleDateString() : '';
              
              rows.push({
                  'Nome': c.lead_nome || 'Sem Nome',
                  'Telefone': String(telVal),
                  'Corretor': c.corretor_nome || 'Sem corretor',
                  'Funil': c.funil_nome || '',
                  'Etapa atual': c.etapa_nome || '',
                  'Último atendimento registrado': dataUltimo,
                  'Situação dos comentários': sitComentarios,
                  'Marcado para reunião': isMarked ? 'Sim' : 'Não',
                  'Última ação combinada': atual.proxima_acao || '',
                  'Situação': atual.situacao || '',
                  'Prazo': prazoFormatado,
                  'ID': String(c.lead_id),
                  'Link do atendimento': `https://app.imobtotal.com.br/atendimentos/${c.lead_id}`
              });
          });
          
          const worksheet = XLSX.utils.json_to_sheet(rows);
          
          // Formatar colunas 'Telefone' e 'ID' estritamente como TEXTO
          const range = XLSX.utils.decode_range(worksheet['!ref']);
          for (let R = range.s.r; R <= range.e.r; ++R) {
              for (let C = range.s.c; C <= range.e.c; ++C) {
                  const cellRef = XLSX.utils.encode_cell({ r: R, c: C });
                  const cell = worksheet[cellRef];
                  if (!cell) continue;
                  const colHeader = worksheet[XLSX.utils.encode_cell({ r: 0, c: C })]?.v;
                  if (colHeader === 'Telefone' || colHeader === 'ID') {
                      cell.t = 's';
                      cell.z = '@';
                  }
              }
          }
          
          const workbook = XLSX.utils.book_new();
          XLSX.utils.book_append_sheet(workbook, worksheet, 'Carteira');
          
          const dataHora = new Date().toISOString().slice(0, 10);
          XLSX.writeFile(workbook, `carteira_clientes_${dataHora}.xlsx`);
      }

      function renderCardsTable(keepPage = false) {
      if (!currentData || !currentData.registros || !currentData.registros.cards) return;
      
      const funilFilter = document.getElementById('filter-funil').value;
      const corretorFilter = document.getElementById('filter-corretor').value;
      
      let allCards = currentData.registros.cards.filter(c => {
         let matchFunil = false;
         if (funilFilter === 'todos' || funilFilter === 'todos_incluindo_3500') {
             matchFunil = true;
         } else if (funilFilter === 'todos_exceto_3500') {
             matchFunil = (c.funil_id != 3500);
         } else {
             matchFunil = (c.funil_id == funilFilter);
         }

         let matchCorretor = (corretorFilter === 'todos' || corretorFilter === '' || !corretorFilter) || (c.corretor_nome == corretorFilter);
         return matchFunil && matchCorretor;
      });

      // Transformação de Nomes de Etapa baseada em flags de divergência
      allCards = allCards.map(c => {
         const novoCard = { ...c };
         if (novoCard.nao_localizado_no_crm) {
             novoCard._etapa_nome_original = novoCard.etapa_nome;
             novoCard.etapa_nome = "⚠️ Não localizado no funil atual do CRM";
         } else if (novoCard.divergente) {
             novoCard._etapa_nome_original = novoCard.etapa_nome;
             novoCard.etapa_nome = "Etapa atual não confirmada";
         }
         return novoCard;
      });

        // 1) Descobrir todas as etapas únicas APÓS o filtro de funil/corretor e aplicar na combo
        const uniqueEtapas = [...new Set(allCards.map(c => c.etapa_nome))].sort();
        const etapaSelect = document.getElementById('filter-etapa');
        const currEtapa = etapaSelect.value;
        etapaSelect.innerHTML = '<option value="">Todas as Etapas</option>';
        uniqueEtapas.forEach(e => {
            const selected = (e === currEtapa) ? 'selected' : '';
            etapaSelect.innerHTML += `<option value="${e}" ${selected}>${e}</option>`;
        });
        
        // Se a etapa atual não existe mais nas opções, limpar o filtro
        if (currEtapa && !uniqueEtapas.includes(currEtapa)) {
            etapaSelect.value = '';
        }
        
        const etapaFilter = etapaSelect.value;
        const container = document.getElementById('analyze-results-content');
        
        const term = document.getElementById('filter-search').value.toLowerCase();
        const comentariosFilter = document.getElementById('filter-comentarios').value;
        const pautaFilter = document.getElementById('filter-pauta').value;
        const situacaoFilter = document.getElementById('filter-situacao').value;
        const prazoFilter = document.getElementById('filter-prazo').value;
  
        // -------------------------------------------------------------
        // FASE 3.5M: RÉGUA DE RESUMO DA PAUTA DE REUNIÃO
        // Ajuste 1: Baseado na pauta completa do corretor/funil selecionado
        // Ajuste 2: Exibido apenas se houver corretor selecionado ou se filtro de pauta estiver ativo
        // -------------------------------------------------------------
        const pautaSummaryBar = document.getElementById('pauta-summary-bar');
        const shouldShowSummary = (corretorFilter && corretorFilter !== 'todos' && corretorFilter !== '') || (pautaFilter !== 'todos');
        
        if (shouldShowSummary && pautaSummaryBar) {
            pautaSummaryBar.classList.remove('hidden');
            
            // Cards marcados na pauta para o recorte de funil e corretor ativos (pauta completa)
            const pautaCards = allCards.filter(c => !!uiState.agenda[`${c.lead_id}_${c.funil_id}`]);
            
            const hoje = new Date().toISOString().split('T')[0];
            let countPendentes = 0;
            let countAguardando = 0;
            let countConcluidos = 0;
            let countVencidos = 0;
            let countSemAcomp = 0;
            
            pautaCards.forEach(c => {
                const acompData = (currentData.acompanhamentos || {})[`${c.lead_id}_${c.funil_id}`];
                const a = acompData?.atual;
                if (!a || (!a.resumo && !a.proxima_acao && !a.situacao && !a.previsao)) {
                    countSemAcomp++;
                } else {
                    if (a.situacao === 'Pendente') countPendentes++;
                    else if (a.situacao === 'Aguardando retorno') countAguardando++;
                    else if (a.situacao === 'Concluído') countConcluidos++;
                    
                    // Prazo vencido: data anterior a hoje E situação diferente de Concluído
                    if (a.previsao && a.previsao < hoje && a.situacao !== 'Concluído') {
                        countVencidos++;
                    }
                }
            });
            
            const uniqueClientsPauta = new Set(pautaCards.map(c => c.lead_id)).size;
            
            // Título conforme Ajuste 1
            const titleEl = document.getElementById('pauta-summary-title');
            if (titleEl) {
                if (corretorFilter && corretorFilter !== 'todos' && corretorFilter !== '') {
                    titleEl.innerHTML = `📋 Resumo da Pauta de Reunião • Corretor: <b>${corretorFilter}</b>`;
                } else {
                    titleEl.innerHTML = `📋 Resumo da Pauta de Reunião • <b>Pauta dos corretores selecionados</b>`;
                }
            }
            
            document.getElementById('kpi-pauta-total').innerText = pautaCards.length;
            document.getElementById('kpi-pauta-unicos').innerText = `(${uniqueClientsPauta} clientes)`;
            document.getElementById('kpi-pauta-pendentes').innerText = countPendentes;
            document.getElementById('kpi-pauta-aguardando').innerText = countAguardando;
            document.getElementById('kpi-pauta-concluidos').innerText = countConcluidos;
            document.getElementById('kpi-pauta-vencidos').innerText = countVencidos;
            document.getElementById('kpi-pauta-sem-acomp').innerText = countSemAcomp;
        } else if (pautaSummaryBar) {
            pautaSummaryBar.classList.add('hidden');
        }

        uiState.filteredCards = allCards.filter(c => {
           const matchTerm = term === '' || 
                             c.lead_nome.toLowerCase().includes(term) || 
                             c.lead_id.toString().includes(term);
           
           const matchEtapa = etapaFilter === '' || c.etapa_nome === etapaFilter;
           
           const resumo = currentData.cache_resumo[c.lead_id] || { status: 'nao_verificado' };
         
         let matchComentarios = true;
         if (comentariosFilter !== 'todos') {
            matchComentarios = (resumo.status === comentariosFilter);
         }
         
         const keyAcomp = `${c.lead_id}_${c.funil_id}`;
         const acompData = (currentData.acompanhamentos || {})[keyAcomp] || {};
         const atual = acompData.atual || {};
         
         let matchPauta = true;
         const isMarked = !!uiState.agenda[keyAcomp];
         if (pautaFilter === 'marcados') {
            matchPauta = isMarked;
         } else if (pautaFilter === 'retomar') {
            if (!isMarked) {
                matchPauta = false;
            } else {
                const currSit = atual.situacao || '';
                const hoje = new Date().toISOString().split('T')[0];
                const isVencido = atual.previsao && (atual.previsao < hoje) && (currSit !== 'Concluído');
                const isPendente = (currSit === 'Pendente');
                const isAguardando = (currSit === 'Aguardando retorno');
                const isSemAcomp = !acompData.atual || (!atual.resumo && !atual.proxima_acao && !atual.situacao && !atual.previsao);
                matchPauta = (isPendente || isAguardando || isVencido || isSemAcomp);
            }
         } else if (pautaFilter === 'dispensados') {
            matchPauta = (!isMarked && acompData.status_pauta === 'dispensado');
         }
         
         let matchSituacao = true;
         if (situacaoFilter !== 'todos') {
             if (situacaoFilter === 'acoes_executar') {
                 const currSit = atual.situacao || '';
                 matchSituacao = (currSit === 'Pendente' || currSit === 'Aguardando retorno');
             } else if (situacaoFilter === 'sem_acomp') {
                 matchSituacao = !acompData.atual || (!atual.resumo && !atual.proxima_acao && !atual.situacao && !atual.previsao);
             } else {
                 const currSit = atual.situacao || 'Não informado';
                 matchSituacao = (currSit === situacaoFilter);
             }
         }
         
         let matchPrazo = true;
         if (prazoFilter === 'vencido') {
             if (!atual.previsao) {
                 matchPrazo = false; // sem prazo não vence
             } else {
                 const hoje = new Date().toISOString().split('T')[0];
                 const isAberto = (atual.situacao !== 'Concluído');
                 matchPrazo = (atual.previsao < hoje && isAberto);
             }
         }
         
         return matchTerm && matchEtapa && matchComentarios && matchPauta && matchSituacao && matchPrazo;
      });

      // Atualizar contagens
      const leadsMap = {};
      uiState.filteredCards.forEach(c => { leadsMap[c.lead_id] = true; });
      const uniqueLeadsCount = Object.keys(leadsMap).length;
      document.getElementById('gestao-stats-layer1').innerHTML = 
          `${uniqueLeadsCount} Clientes Únicos e ${uiState.filteredCards.length} Cards na seleção (Reflete pauta e filtros da tabela)`;

      // Atualizar estado do master checkbox
      const masterCheck = document.getElementById('check-select-all');
      if (masterCheck) {
          if (uiState.filteredCards.length === 0) {
              masterCheck.checked = false;
              masterCheck.indeterminate = false;
          } else {
              const totalFiltered = uiState.filteredCards.length;
