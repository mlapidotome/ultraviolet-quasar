                        <button id="btn-fetch-${c.lead_id}" onclick="fetchRealHistory(${c.lead_id}, 'btn-fetch-${c.lead_id}')" class="text-gray-700 px-3 py-1 rounded text-xs font-bold bg-gray-200 hover:bg-gray-300 transition shadow">
                          Tentar Novamente / Consultar
                        </button>`;
        } else if (histData && histData.atividades) {
            const dataConsultaStr = new Date(histData.consultado_em).toLocaleString();
            histHtml += `<div class="bg-blue-50 border border-blue-200 text-blue-900 p-3 rounded text-xs mb-3">
                           <div class="flex justify-between items-center mb-1">
                             <p class="font-bold">⚠️ Histórico Global (2ª Camada)</p>
