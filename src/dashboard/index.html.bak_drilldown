            }).join('');

            historicoHtml = `
              <div class="mt-3 pt-2 border-t border-amber-200">
                <button type="button" onclick="toggleHistoricoAcomp('${histId}')" class="text-amber-800 hover:text-amber-900 font-bold text-xs flex items-center gap-1.5 py-1 px-1 rounded hover:bg-amber-100/60 transition">
                  <span id="icon-${histId}" class="text-[10px]">▶</span>
                  <span class="underline">Ver versões anteriores (${acomp.historico.length})</span>
                </button>
                <div id="${histId}" class="hidden mt-2 max-h-56 overflow-y-auto pr-1">
                  <div class="text-[10px] text-gray-500 mb-1.5 italic font-medium">Registros anteriores desta reunião (mais recentes primeiro):</div>
                  ${itensHtml}
                </div>
              </div>
            `;
        }
        
        let statusPautaBadge = '';
