    async function executeBulkVerification() {
        isBulkRunning = true;
        document.getElementById('bulk-step-1').classList.add('hidden');
        document.getElementById('bulk-step-2').classList.remove('hidden');
        document.getElementById('btn-stop-bulk').innerText = 'Interromper fila';
        document.getElementById('btn-stop-bulk').disabled = false;
        document.getElementById('btn-stop-bulk').classList.remove('hidden');
        document.getElementById('btn-close-bulk').classList.add('hidden');
        
        const logEl = document.getElementById('bulk-log');
        logEl.innerHTML = '';
        const logMsg = (msg, isErr=false) => {
            const div = document.createElement('div');
            div.className = isErr ? 'text-red-600 font-bold mb-1' : 'text-gray-700 mb-1';
            div.innerText = msg;
            logEl.appendChild(div);
            logEl.scrollTop = logEl.scrollHeight;
        };
        
        const total = uiState.bulkQueue.length;
        let currentIdx = 0;
        let stats = { com: 0, sem: 0, falha: 0, reqs: 0 };
        
        for (const leadId of uiState.bulkQueue) {
            if (!isBulkRunning) {
                logMsg("--- FILA INTERROMPIDA PELO USUÁRIO ---", true);
                break;
            }
            currentIdx++;
            
            document.getElementById('bulk-status-text').innerText = `Verificando cliente ${currentIdx} de ${total} (ID: ${leadId})...`;
            document.getElementById('bulk-progress-bar').style.width = `${(currentIdx / total) * 100}%`;
            
            stats.reqs++;
            try {
                const res = await fetch('/api/real-history-single', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ leadId })
                });
                
                const data = await res.json();
                
                if (!res.ok) {
                    stats.falha++;
                    logMsg(`[ID ${leadId}] Falha: ${data.error || res.statusText}`, true);
                    if (res.status === 401 || res.status === 403 || res.status === 429) {
                        logMsg("Parada de segurança: Bloqueio ou falha de autenticação na API.", true);
                        isBulkRunning = false;
                        break;
                    }
                    continue;
                }
                
                // Grava cache em memória para a tabela usar instantaneamente
                uiState.historicos[leadId] = { atividades: data.atividades || [], consultado_em: data.consultado_em };
                
                const qtd = (data.atividades || []).length;
                let ultimo = null;
                if (qtd > 0) {
                    const first = data.atividades[0];
                    ultimo = first.data_criacao || first.data_cadastro || first.created_at || first.data;
                }
                
                currentData.cache_resumo[leadId] = {
                    status: qtd > 0 ? 'com_comentarios' : 'sem_comentarios',
                    qtd_comentarios: qtd,
                    data_ultimo_comentario: ultimo,
                    consultado_em: data.consultado_em
                };
                
                if (qtd > 0) {
                    stats.com++;
                    logMsg(`[ID ${leadId}] ${qtd} comentário(s) encontrado(s).`);
                } else {
                    stats.sem++;
                    logMsg(`[ID ${leadId}] Sem comentários.`);
                }
                
                // Pausa de segurança para não engarrafar a UI nem bater na API muito agressivamente do lado do browser
                await new Promise(r => setTimeout(r, 500));
                
            } catch (err) {
                stats.falha++;
                logMsg(`[ID ${leadId}] Erro de conexão: ${err.message}`, true);
            }
        }
        
        isBulkRunning = false;
        document.getElementById('bulk-status-text').innerText = "Verificação concluída (ou interrompida).";
        
        logMsg("---------------------------------");
        logMsg("RESUMO DA EXECUÇÃO");
        logMsg(`Total de requisições: ${stats.reqs}`);
        logMsg(`Clientes COM comentários: ${stats.com}`);
        logMsg(`Clientes SEM comentários: ${stats.sem}`);
        logMsg(`Falhas / Restantes na fila: ${stats.falha + (total - currentIdx)}`);
        
        document.getElementById('btn-stop-bulk').classList.add('hidden');
        document.getElementById('btn-close-bulk').classList.remove('hidden');
    }

