    function prepareBulkVerification() {
      if (isBulkRunning) {
          alert("Uma verificação em lote já está em andamento. Aguarde ou interrompa a atual.");
          return;
      }
      
      if (!currentData || !currentData.registros.cards) return;
      const allCards = currentData.registros.cards;
      
      // Aplica apenas os filtros ignorando o filtro de 'Situação dos Comentários'
      const term = document.getElementById('filter-search').value.toLowerCase();
      const pautaFilter = document.getElementById('filter-pauta').value;

      const targetCards = allCards.filter(c => {
         const matchTerm = term === '' || 
                           c.lead_nome.toLowerCase().includes(term) || 
                           c.lead_id.toString().includes(term);
         let matchPauta = true;
         const keyAcomp = c.lead_id + '_' + c.funil_id;
         const isMarked = !!uiState.agenda[keyAcomp];
         if (pautaFilter === 'marcados') {
            matchPauta = isMarked;
         } else if (pautaFilter === 'retomar') {
             if (!isMarked) {
                 matchPauta = false;
             } else {
                 const acompData = (currentData.acompanhamentos || {})[keyAcomp] || {};
                 const atual = acompData.atual || {};
                 const currSit = atual.situacao || '';
                 const hoje = new Date().toISOString().split('T')[0];
                 const isVencido = atual.previsao && (atual.previsao < hoje) && (currSit !== 'Concluído');
                 const isPendente = (currSit === 'Pendente');
                 const isAguardando = (currSit === 'Aguardando retorno');
                 const isSemAcomp = !acompData.atual || (!atual.resumo && !atual.proxima_acao && !atual.situacao && !atual.previsao);
                 matchPauta = (isPendente || isAguardando || isVencido || isSemAcomp);
             }
         } else if (pautaFilter === 'dispensados') {
             const acompData = (currentData.acompanhamentos || {})[keyAcomp] || {};
             matchPauta = (!isMarked && acompData.status_pauta === 'dispensado');
         }
         return matchTerm && matchPauta;
      });

      // Deduplicate leads
      const leadsMap = {};
      targetCards.forEach(c => { leadsMap[c.lead_id] = true; });
      const uniqueLeadIds = Object.keys(leadsMap);

      let cachedCount = 0;
      let realPendingCount = 0;
      
      uiState.bulkQueue = [];
      
      uniqueLeadIds.forEach(id => {
         const resumo = currentData.cache_resumo[id] || { status: 'nao_verificado' };
         if (resumo.status === 'com_comentarios' || resumo.status === 'sem_comentarios') {
             cachedCount++;
         } else {
             realPendingCount++;
             uiState.bulkQueue.push(id);
         }
      });

      let testLimitMsg = '';
      const MAX_TEST_LIMIT = 20;
      if (uiState.bulkQueue.length > MAX_TEST_LIMIT) {
         uiState.bulkQueue = uiState.bulkQueue.slice(0, MAX_TEST_LIMIT);
         testLimitMsg = ` <span class="text-red-600 font-bold text-[11px] ml-2">(LIMITADO A ${MAX_TEST_LIMIT} PARA EXPANSÃO CONTROLADA)</span>`;
      }

      document.getElementById('bulk-total').textContent = uniqueLeadIds.length;
      document.getElementById('bulk-cached').textContent = cachedCount;
      document.getElementById('bulk-pending').innerHTML = uiState.bulkQueue.length + testLimitMsg;
      document.getElementById('bulk-reqs').innerHTML = uiState.bulkQueue.length;

      document.getElementById('bulk-step-1').classList.remove('hidden');
      document.getElementById('bulk-step-2').classList.add('hidden');
      document.getElementById('modal-bulk-comments').classList.remove('hidden');
    }
    
    let isBulkRunning = false;
    
    function stopBulkVerification() {
        isBulkRunning = false;
        document.getElementById('btn-stop-bulk').innerText = 'Interrompendo...';
        document.getElementById('btn-stop-bulk').disabled = true;
    }
    
    function closeBulkVerification() {
