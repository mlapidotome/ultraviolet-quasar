  <script>
    let currentData = null;
    let globalOptions = null;
    let globalMetricsData = null;
    let currentTab = 'visao';
    let telefones_cache = {};
    
    // Estado local da UI
    let uiState = {
      currentPage: 1,
        itemsPerPage: 10,
        filteredCards: [],
        historicos: {}, // Simulador de cache de sessão
        agenda: {}
      };

    const EXCLUDED_STAGE_IDS = [15204, 15205, 15257, 15258];

    async function migrateAgendaIfNeeded() {
        const localAgenda = localStorage.getItem('bali_meeting_agenda');
        const migrated = localStorage.getItem('bali_meeting_agenda_migrated');
        if (localAgenda && !migrated) {
            try {
                const agendaObj = JSON.parse(localAgenda);
                if (Object.keys(agendaObj).length > 0) {
                    await fetch('/api/pauta/migrate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ agendaObj })
                    });
                }
                localStorage.setItem('bali_meeting_agenda_migrated', 'true');
            } catch(e) { console.error('Migration error', e); }
        }
    }
    migrateAgendaIfNeeded();

    async function toggleAgenda(leadId, funilId) {
      const key = `${leadId}_${funilId}`;
      const isCurrentlyChecked = !!uiState.agenda[key];
      const newValue = !isCurrentlyChecked;
      
      // Optimistic UI Update
      if (newValue) {
          uiState.agenda[key] = true;
          if (currentData && currentData.acompanhamentos && currentData.acompanhamentos[key]) {
              currentData.acompanhamentos[key].status_pauta = 'manter';
              currentData.acompanhamentos[key].dispensado_em = null;
          }
      } else {
          delete uiState.agenda[key];
      }
      renderCardsTable(true);
      
      try {
          await fetch('/api/pauta/toggle', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ leadId, funilId, checked: newValue })
          });
      } catch(e) {
          console.error(e);
          // Revert on error
          if (isCurrentlyChecked) uiState.agenda[key] = true;
          else delete uiState.agenda[key];
          renderCardsTable(true);
      }
    }

    async function toggleSelectAllFiltered(shouldCheck) {
      if (!uiState.filteredCards || uiState.filteredCards.length === 0) {
          alert("Nenhum lead filtrado para selecionar.");
          return;
      }
      
      const previousState = { ...uiState.agenda };
      const items = [];
      
      uiState.filteredCards.forEach(c => {
          const key = `${c.lead_id}_${c.funil_id}`;
          if (shouldCheck) {
              uiState.agenda[key] = true;
              if (currentData && currentData.acompanhamentos && currentData.acompanhamentos[key]) {
                  currentData.acompanhamentos[key].status_pauta = 'manter';
                  currentData.acompanhamentos[key].dispensado_em = null;
              }
          } else {
              delete uiState.agenda[key];
          }
          items.push({ leadId: c.lead_id, funilId: c.funil_id });
      });
      
      renderCardsTable(true);
      
      try {
          const res = await fetch('/api/pauta/toggle-bulk', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items, checked: shouldCheck })
          });
          if (!res.ok) throw new Error('Falha ao salvar no servidor');
      } catch(e) {
          console.error(e);
          alert('Erro ao salvar seleção em lote: ' + e.message);
          uiState.agenda = previousState;
          renderCardsTable(true);
      }
    }

    function switchTab(tab) {
      currentTab = tab;
      document.getElementById('tab-visao').className = tab === 'visao' ? 'py-2 px-4 tab-active' : 'py-2 px-4 tab-inactive';
      document.getElementById('tab-gestao').className = tab === 'gestao' ? 'py-2 px-4 tab-active text-purple-700 flex items-center gap-2' : 'py-2 px-4 tab-inactive text-purple-700 flex items-center gap-2';
      
      document.getElementById('view-visao-geral').classList.add('hidden');
      document.getElementById('view-gestao').classList.add('hidden');

      if(tab === 'visao') document.getElementById('view-visao-geral').classList.remove('hidden');
      if(tab === 'gestao') {
        document.getElementById('view-gestao').classList.remove('hidden');
        renderGestaoLayer1();
      }
    }

    function populateOptions() {
      if (!globalOptions) return;
      const funilSelect = document.getElementById('filter-funil');
      const corretorSelect = document.getElementById('filter-corretor');

      const currFunil = funilSelect.value;
      const currCorretor = corretorSelect.value;

      funilSelect.innerHTML = '<option value="todos_exceto_3500">Todos exceto Lançamentos</option><option value="todos_incluindo_3500">Absolutamente Todos</option>';
      Object.keys(globalOptions.funis).forEach(id => {
        funilSelect.innerHTML += `<option value="${id}">${globalOptions.funis[id]}</option>`;
      });

      funilSelect.value = currFunil || 'todos_exceto_3500';

      corretorSelect.innerHTML = '<option value="">Todos</option>';
      globalOptions.corretores.forEach(c => {
        corretorSelect.innerHTML += `<option value="${c}">${c}</option>`;
      });
      corretorSelect.value = currCorretor || '';

      updateEtapasOptions();
    }

    function updateEtapasOptions() {
      const funilId = document.getElementById('filter-funil').value;
      const etapaSelect = document.getElementById('filter-etapa');
      const currEtapa = etapaSelect.value;
      
      etapaSelect.innerHTML = '<option value="">Todas</option>';
      
      if (!globalOptions) return;

      if (funilId && globalOptions.etapas_por_funil[funilId]) {
        globalOptions.etapas_por_funil[funilId].forEach(e => {
          etapaSelect.innerHTML += `<option value="${e}">${e}</option>`;
        });
      } else {
        const allStages = new Set();
        Object.values(globalOptions.etapas_por_funil).forEach(etapas => {
          etapas.forEach(e => allStages.add(e));
        });
        Array.from(allStages).sort().forEach(e => {
          etapaSelect.innerHTML += `<option value="${e}">${e}</option>`;
        });
      }
      if (currEtapa) etapaSelect.value = currEtapa;
    }

    function gotoGestaoCorretor(funilId, corretorNome) {
       document.getElementById('filter-funil').value = funilId;
       updateEtapasOptions();
       document.getElementById('filter-etapa').value = '';
       document.getElementById('filter-corretor').value = corretorNome;
       switchTab('gestao');
       applyFilters();
    }

    function applyFilters() {
      const inicio = document.getElementById('filter-inicio').value;
      const fim = document.getElementById('filter-fim').value;
      const funil = document.getElementById('filter-funil').value;
      const etapa = document.getElementById('filter-etapa').value;
      const corretor = document.getElementById('filter-corretor').value;

      const params = new URLSearchParams();
      if (inicio) params.append('inicio', inicio);
      if (fim) params.append('fim', fim);
      if (funil) params.append('funil', funil);
      if (etapa) params.append('etapa', etapa);
      if (corretor) params.append('corretor', corretor);

      uiState.currentPage = 1; // Reseta paginação
      loadDashboard(params.toString());
    }

    function clearFilters() {
      document.getElementById('filter-inicio').value = '';
      document.getElementById('filter-fim').value = '';
      document.getElementById('filter-funil').value = 'todos_exceto_3500';
      document.getElementById('filter-etapa').value = '';
      document.getElementById('filter-corretor').value = '';
      document.getElementById('filter-search').value = '';
