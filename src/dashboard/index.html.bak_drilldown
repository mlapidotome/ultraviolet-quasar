    async function fetchRealHistory(leadId, btnId, forceUpdate = false) {
      if (forceUpdate) {
          const ok = confirm(`Deseja atualizar manualmente os comentários no ImobTotal para o Lead ID ${leadId}? Isto consumirá uma requisição real.`);
          if (!ok) return;
      } else {
          const ok = confirm(`Deseja consultar os comentários no ImobTotal para o Lead ID ${leadId}?`);
          if (!ok) return;
      }
      
      const buttonEl = document.getElementById(btnId);
      if(buttonEl) buttonEl.disabled = true;
      
      try {
        const res = await fetch('/api/real-history-single', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ leadId, forceUpdate })
        });
        
        const data = await res.json();
        
        if (res.status === 410) {
          uiState.historicos[leadId] = { error: "Histórico não disponível — consultar novamente" };
          renderCardsTable(true);
          return;
        }

        if (!res.ok) {
          uiState.historicos[leadId] = { error: data.error || "Erro desconhecido" };
          renderCardsTable(true);
          return;
        }
        
        // Salva na memória do painel para a sessão (data.atividades e data.consultado_em)
        uiState.historicos[leadId] = { 
           atividades: data.atividades || [], 
           consultado_em: data.consultado_em 
        };
        
        renderCardsTable(true);
      } catch (err) {
        uiState.historicos[leadId] = { error: err.message };
        renderCardsTable(true);
      }
    }

