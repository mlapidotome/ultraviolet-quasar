              if (data.na_pauta) uiState.agenda[key] = true;
              else delete uiState.agenda[key];
           }
           if (!currentData.acompanhamentos) currentData.acompanhamentos = {};
           if (!currentData.acompanhamentos[key]) currentData.acompanhamentos[key] = { historico: [] };
           if (data.status_pauta !== undefined) {
              currentData.acompanhamentos[key].status_pauta = data.status_pauta;
           }
           currentData.acompanhamentos[key].atual = data.saved;
           
           setTimeout(() => {
