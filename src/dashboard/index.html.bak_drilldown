        } else if (resumo.status === 'sem_comentarios') {
            const dtColeta = new Date(resumo.consultado_em).toLocaleString();
            cellComentariosHtml = `
               <span class="block text-xs text-gray-600 font-bold">Sem comentários</span>
               <span class="block text-gray-400 text-[9px] mt-1" title="Data da coleta">Consultado: ${dtColeta}</span>
