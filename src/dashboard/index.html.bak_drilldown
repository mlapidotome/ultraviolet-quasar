                           <p class="mb-2 text-blue-700 border-b border-blue-200 pb-2">Não reflete necessariamente ações de '${c.etapa_nome}'. Serve apenas como contexto geral do cliente.</p>`;
            
            if (histData.atividades.length > 0) {
               histData.atividades.forEach(a => {
                  const dateStr = a.data_criacao ? new Date(a.data_criacao).toLocaleString() : '';
                  histHtml += `<div class="mb-2 pb-2 border-b border-blue-100 last:border-0 last:mb-0 last:pb-0">
