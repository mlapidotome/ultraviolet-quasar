    // --- CONTROLE DO MODAL DE RESUMO DOS COMBINADOS (Fase 3.5N) ---
    let resumoTextoOriginal = '';
    let resumoHasUnsavedChanges = false;

    function openResumoModal() {
      const modal = document.getElementById('modal-resumo-reuniao');
      const corretorSelect = document.getElementById('modal-resumo-corretor');
      const dataInput = document.getElementById('modal-resumo-data');
      
      // Popular corretores com opção inicial de orientação
      corretorSelect.innerHTML = '<option value="">-- Selecione um Corretor --</option>';
      const corretores = (globalOptions && globalOptions.corretores) ? globalOptions.corretores : [];
      corretores.forEach(c => {
        corretorSelect.innerHTML += `<option value="${c}">${c}</option>`;
      });

      // Seleção inicial: se já houver corretor selecionado no filtro da tela, usa ele
      const filtroCorretor = document.getElementById('filter-corretor').value;
      if (filtroCorretor && corretores.includes(filtroCorretor)) {
        corretorSelect.value = filtroCorretor;
      } else {
        corretorSelect.value = '';
      }

      // Data padrão: hoje no horário local
      const hoje = new Date();
      const ano = hoje.getFullYear();
      const mes = String(hoje.getMonth() + 1).padStart(2, '0');
      const dia = String(hoje.getDate()).padStart(2, '0');
      dataInput.value = `${ano}-${mes}-${dia}`;

      modal.classList.remove('hidden');
      carregarOuGerarResumo();
    }

    function fecharResumoModal() {
      if (resumoHasUnsavedChanges) {
        const confirmar = confirm("Atenção: existem alterações não salvas no texto do resumo. Deseja realmente fechar?");
        if (!confirmar) return;
      }
      document.getElementById('modal-resumo-reuniao').classList.add('hidden');
      resumoHasUnsavedChanges = false;
      document.getElementById('modal-resumo-unsaved-badge').classList.add('hidden');
    }

    function onResumoParamsChange() {
      if (resumoHasUnsavedChanges) {
        const confirmar = confirm("Atenção: você alterou o corretor ou data com alterações não salvas no resumo atual. Deseja continuar e carregar os dados da nova seleção?");
        if (!confirmar) return;
      }
      carregarOuGerarResumo();
    }

    function onResumoTextareaChange() {
      const textoAtual = document.getElementById('modal-resumo-texto').value;
      const unsavedBadge = document.getElementById('modal-resumo-unsaved-badge');
      if (textoAtual !== resumoTextoOriginal) {
        resumoHasUnsavedChanges = true;
        unsavedBadge.classList.remove('hidden');
      } else {
        resumoHasUnsavedChanges = false;
        unsavedBadge.classList.add('hidden');
      }
    }

    async function carregarOuGerarResumo() {
      const corretor = document.getElementById('modal-resumo-corretor').value;
      const dataReuniao = document.getElementById('modal-resumo-data').value;
      const alertEl = document.getElementById('modal-resumo-status-alert');
      const textarea = document.getElementById('modal-resumo-texto');
      const unsavedBadge = document.getElementById('modal-resumo-unsaved-badge');

      if (!corretor) {
        alertEl.className = 'text-xs p-2.5 rounded mb-3 bg-amber-50 text-amber-800 border border-amber-200 font-medium';
        alertEl.textContent = "ℹ️ Selecione um corretor para visualizar ou gerar o resumo dos combinados.";
        alertEl.classList.remove('hidden');
        textarea.value = '';
        textarea.placeholder = 'Selecione um corretor acima e clique em Carregar / Gerar...';
        unsavedBadge.classList.add('hidden');
        resumoTextoOriginal = '';
        resumoHasUnsavedChanges = false;
        return;
      }

      if (!dataReuniao) {
        alertEl.className = 'text-xs p-2.5 rounded mb-3 bg-amber-50 text-amber-800 border border-amber-200 font-medium';
        alertEl.textContent = "ℹ️ Selecione a data da reunião para visualizar ou gerar o resumo dos combinados.";
        alertEl.classList.remove('hidden');
        textarea.value = '';
        textarea.placeholder = 'Selecione a data acima e clique em Carregar / Gerar...';
        unsavedBadge.classList.add('hidden');
        resumoTextoOriginal = '';
        resumoHasUnsavedChanges = false;
        return;
      }

      alertEl.className = 'text-xs p-2 rounded mb-3 bg-blue-50 text-blue-800 border border-blue-200';
      alertEl.textContent = "Carregando dados da reunião...";
      alertEl.classList.remove('hidden');

      try {
        // 1. Verificar se já existe um resumo salvo para este corretor e data
        const resSalvo = await fetch(`/api/reunioes/resumos?corretor=${encodeURIComponent(corretor)}&data=${encodeURIComponent(dataReuniao)}`);
        const salvoData = resSalvo.ok ? await resSalvo.json() : null;

        if (salvoData && salvoData.texto) {
          textarea.value = salvoData.texto;
          resumoTextoOriginal = salvoData.texto;
          resumoHasUnsavedChanges = false;
          unsavedBadge.classList.add('hidden');

          const salvoEmFmt = salvoData.salvo_em ? new Date(salvoData.salvo_em).toLocaleString() : '';
          alertEl.className = 'text-xs p-2 rounded mb-3 bg-green-50 text-green-800 border border-green-200 flex justify-between items-center';
          alertEl.innerHTML = `
            <span>💾 <b>Resumo previamente salvo carregado.</b> ${salvoEmFmt ? `(Salvo em ${salvoEmFmt})` : ''}</span>
            <button onclick="regerarResumoDosDados()" class="text-xs text-blue-700 underline font-bold hover:text-blue-900 ml-2">Regerar a partir dos dados atuais</button>
          `;
          return;
        }

        // 2. Se não existir resumo salvo, gerar dinamicamente a partir dos acompanhamentos
        await regerarResumoDosDados();

      } catch (err) {
        console.error(err);
        alertEl.className = 'text-xs p-2 rounded mb-3 bg-red-50 text-red-800 border border-red-200';
        alertEl.textContent = "Erro ao carregar dados: " + err.message;
      }
    }

    async function regerarResumoDosDados() {
      const corretor = document.getElementById('modal-resumo-corretor').value;
      const dataReuniao = document.getElementById('modal-resumo-data').value;
      const alertEl = document.getElementById('modal-resumo-status-alert');
      const textarea = document.getElementById('modal-resumo-texto');
      const unsavedBadge = document.getElementById('modal-resumo-unsaved-badge');

      const res = await fetch(`/api/reunioes/gerar-resumo?corretor=${encodeURIComponent(corretor)}&data=${encodeURIComponent(dataReuniao)}`);
      if (!res.ok) throw new Error('Falha ao gerar resumo no servidor');
      const genData = await res.json();

      textarea.value = genData.texto || '';
      resumoTextoOriginal = genData.texto || '';
      resumoHasUnsavedChanges = false;
      unsavedBadge.classList.add('hidden');

      if (genData.total_cards > 0) {
        alertEl.className = 'text-xs p-2 rounded mb-3 bg-indigo-50 text-indigo-800 border border-indigo-200';
        alertEl.textContent = `✨ Resumo gerado com sucesso: ${genData.total_cards} card(s) alinhado(s) para ${corretor} em ${genData.data_formatada}. Revise o texto antes de copiar.`;
      } else {
        alertEl.className = 'text-xs p-2 rounded mb-3 bg-amber-50 text-amber-800 border border-amber-200 font-medium';
        alertEl.textContent = "Nenhum acompanhamento registrado para este corretor nesta data.";
      }
    }

    async function copiarResumoWhatsApp() {
      const textarea = document.getElementById('modal-resumo-texto');
      const btnCopiar = document.getElementById('btn-copiar-resumo');
      const texto = textarea.value.trim();

      if (!texto) {
        alert("O texto do resumo está vazio.");
        return;
      }

      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(texto);
        } else {
          textarea.select();
          document.execCommand('copy');
        }

        const originalHtml = btnCopiar.innerHTML;
        btnCopiar.innerHTML = `✓ Copiado para o WhatsApp!`;
        btnCopiar.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
        btnCopiar.classList.add('bg-green-700');

        setTimeout(() => {
          btnCopiar.innerHTML = originalHtml;
          btnCopiar.classList.remove('bg-green-700');
          btnCopiar.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
        }, 2000);
      } catch (err) {
        console.error("Falha ao copiar:", err);
        textarea.select();
        document.execCommand('copy');
        alert("Texto copiado para a área de transferência!");
      }
    }

    async function salvarResumoLocalmente(overwrite = false) {
      const corretor = document.getElementById('modal-resumo-corretor').value;
      const dataReuniao = document.getElementById('modal-resumo-data').value;
      const textarea = document.getElementById('modal-resumo-texto');
      const alertEl = document.getElementById('modal-resumo-status-alert');
      const unsavedBadge = document.getElementById('modal-resumo-unsaved-badge');
      const texto = textarea.value;

      try {
        const res = await fetch('/api/reunioes/resumos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ corretor, data_reuniao: dataReuniao, texto_resumo: texto, overwrite })
        });

        if (res.status === 409) {
          const confirmar = confirm("Atenção: já existe um resumo salvo para este corretor nesta data.\n\nDeseja sobrescrever com o texto atual?");
          if (confirmar) {
            return await salvarResumoLocalmente(true);
          } else {
            return;
          }
        }

        if (!res.ok) {
          const errData = await res.json();
          throw new Error(errData.error || 'Erro ao salvar resumo');
        }

        const data = await res.json();
        resumoTextoOriginal = texto;
        resumoHasUnsavedChanges = false;
        unsavedBadge.classList.add('hidden');

        alertEl.className = 'text-xs p-2 rounded mb-3 bg-green-50 text-green-800 border border-green-200';
        alertEl.innerHTML = `💾 <b>Resumo salvo localmente com sucesso!</b> (Vinculado a ${corretor} na data ${dataReuniao})`;
        alertEl.classList.remove('hidden');

      } catch (err) {
        console.error(err);
        alert("Erro ao salvar resumo: " + err.message);
      }
    }

    // --- FASE 3.5P: ROTINAS DE ATUALIZAÇÃO SEGURA DA CARTEIRA ---
    let currentSyncSessionId = null;
    let currentSyncIsSimulated = false;
    let currentSyncCreatedAt = null;
    let currentSyncDiffReport = null;
    let syncAppliedSuccessfully = false;

    function formatarDataHoraBr(isoStr) {
      if (!isoStr) return 'Não disponível';
      const d = new Date(isoStr);
      if (isNaN(d.getTime())) return isoStr;
      const dia = String(d.getDate()).padStart(2, '0');
      const mes = String(d.getMonth() + 1).padStart(2, '0');
      const ano = d.getFullYear();
      const hora = String(d.getHours()).padStart(2, '0');
      const min = String(d.getMinutes()).padStart(2, '0');
      return `${dia}/${mes}/${ano} às ${hora}:${min}`;
    }

    function setSyncStepper(stepNum) {
      const activeClass = "py-1.5 px-1 rounded bg-blue-100 text-blue-900 border border-blue-400 font-extrabold shadow-xs transition";
      const doneClass = "py-1.5 px-1 rounded bg-slate-100 text-slate-700 border border-slate-300 font-semibold transition";
      const pendingClass = "py-1.5 px-1 rounded bg-gray-50 text-gray-400 border border-gray-200 font-normal transition";
      const successClass = "py-1.5 px-1 rounded bg-emerald-100 text-emerald-900 border border-emerald-400 font-extrabold shadow-xs transition";

      for (let i = 1; i <= 4; i++) {
        const el = document.getElementById(`step-ind-${i}`);
        if (!el) continue;
        if (stepNum === 4 && i === 4) {
          el.className = successClass;
        } else if (i === stepNum) {
          el.className = activeClass;
        } else if (i < stepNum) {
          el.className = doneClass;
        } else {
          el.className = pendingClass;
        }
      }
    }

    function openSyncModal() {
      currentSyncSessionId = null;
      currentSyncCreatedAt = null;
      currentSyncDiffReport = null;
      syncAppliedSuccessfully = false;

      setSyncStepper(1);
      document.getElementById('sync-step-1').classList.remove('hidden');
      document.getElementById('sync-step-2').classList.add('hidden');
      document.getElementById('sync-step-3').classList.add('hidden');
      document.getElementById('sync-step-4').classList.add('hidden');
      document.getElementById('modal-sync-leads').classList.remove('hidden');
    }

    function closeSyncModal() {
      document.getElementById('modal-sync-leads').classList.add('hidden');
      currentSyncSessionId = null;
      currentSyncCreatedAt = null;
      currentSyncDiffReport = null;
      syncAppliedSuccessfully = false;
    }

    // Proteção contra fechamento acidental se houver prévia aguardando confirmação (Item 5)
    function requestCloseSyncModal() {
      if (currentSyncSessionId && !syncAppliedSuccessfully) {
        const confirmarSaida = confirm("A atualização ainda não foi gravada. Se você sair agora, as alterações não serão aplicadas ao painel. Deseja sair mesmo assim?");
        if (!confirmarSaida) return;
      }
      closeSyncModal();
    }

    function checkSyncSessionExpired() {
      if (!currentSyncCreatedAt) return false;
      const isExp = (Date.now() - currentSyncCreatedAt) > 15 * 60 * 1000;
      if (isExp) {
        const expBanner = document.getElementById('sync-expired-banner');
        const warnBanner = document.getElementById('sync-warning-banner');
        const btnApply = document.getElementById('btn-apply-sync');
        if (expBanner) expBanner.classList.remove('hidden');
        if (warnBanner) warnBanner.classList.add('hidden');
        if (btnApply) {
          btnApply.disabled = true;
          btnApply.classList.add('opacity-50', 'cursor-not-allowed');
        }
      }
      return isExp;
    }

    async function startSyncPreview() {
      setSyncStepper(2);
      document.getElementById('sync-step-1').classList.add('hidden');
      document.getElementById('sync-step-2').classList.remove('hidden');
      document.getElementById('sync-step-3').classList.add('hidden');
      document.getElementById('sync-step-4').classList.add('hidden');

      const progressBar = document.getElementById('sync-progress-bar');
      const progressStatus = document.getElementById('sync-progress-status');
      const progressPercent = document.getElementById('sync-progress-percent');

      progressBar.style.width = '20%';
      progressPercent.innerText = '20%';
      progressStatus.innerText = 'Iniciando consulta controlada nos 4 funis em memória...';

      let progressVal = 20;
      const interval = setInterval(() => {
        if (progressVal < 90) {
          progressVal += 10;
          progressBar.style.width = progressVal + '%';
          progressPercent.innerText = progressVal + '%';
          if (progressVal === 30) progressStatus.innerText = 'Consultando Terceiros (3515) e MAP (5297)...';
          if (progressVal === 50) progressStatus.innerText = 'Consultando MCMV (5308) e Lançamentos (3500)...';
          if (progressVal === 70) progressStatus.innerText = 'Paginando etapas ativas com novos registros...';
          if (progressVal === 85) progressStatus.innerText = 'Comparando alterações e gerando relatório de conciliação...';
        }
      }, 500);

      try {
        const res = await fetch('/api/sync/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ isSimulated: false })
        });

        clearInterval(interval);
        progressBar.style.width = '100%';
        progressPercent.innerText = '100%';

        if (!res.ok) {
          const errData = await res.json();
          throw new Error(errData.error || 'Erro na consulta prévia');
        }

        const data = await res.json();
        if (!data.success || !data.sessionId) {
          throw new Error(data.error || 'A consulta foi incompleta');
        }

        currentSyncSessionId = data.sessionId;
        currentSyncCreatedAt = Date.now();
        currentSyncDiffReport = data.diffReport;
        currentSyncIsSimulated = data.isSimulated || false;
        syncAppliedSuccessfully = false;

        renderSyncDiff(data.diffReport);

        setTimeout(() => {
          setSyncStepper(3);
          document.getElementById('sync-step-2').classList.add('hidden');
          document.getElementById('sync-step-3').classList.remove('hidden');

          const expBanner = document.getElementById('sync-expired-banner');
          const warnBanner = document.getElementById('sync-warning-banner');
          const btnApply = document.getElementById('btn-apply-sync');
          if (expBanner) expBanner.classList.add('hidden');
          if (warnBanner) warnBanner.classList.remove('hidden');
          if (btnApply) {
            btnApply.disabled = false;
            btnApply.classList.remove('opacity-50', 'cursor-not-allowed');
            btnApply.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> CONFIRMAR E ATUALIZAR PAINEL`;
          }
        }, 400);

      } catch (err) {
        clearInterval(interval);
        console.error(err);
        alert("Falha na consulta ao CRM: " + err.message + "\n\nO snapshot anterior permanece 100% inalterado.");
        closeSyncModal();
      }
    }

    function renderSyncDiff(diff) {
      // 1. Painel Antes / Depois
      const leadsAntes = diff.leadsUnicosAntes || 0;
      const leadsDepois = diff.leadsUnicosDepois || 0;
      const leadsDif = leadsDepois - leadsAntes;
      document.getElementById('sync-leads-antes').innerText = leadsAntes;
      document.getElementById('sync-leads-depois').innerText = leadsDepois;
      document.getElementById('sync-leads-dif').innerText = leadsDif >= 0 ? `(+${leadsDif} novo(s))` : `(${leadsDif})`;

      const cardsAntes = diff.totalCardsAntes || 0;
      const cardsDepois = diff.totalCardsDepois || 0;
      const cardsDif = cardsDepois - cardsAntes;
      document.getElementById('sync-cards-antes').innerText = cardsAntes;
      document.getElementById('sync-cards-depois').innerText = cardsDepois;
      document.getElementById('sync-cards-dif').innerText = cardsDif >= 0 ? `(+${cardsDif} novo(s) card(s))` : `(${cardsDif})`;

      document.getElementById('sync-mov-etapas').innerText = `${diff.mudancasEtapa ? diff.mudancasEtapa.length : 0} etapa(s)`;
      document.getElementById('sync-mov-corretores').innerText = `${diff.mudancasResponsavel ? diff.mudancasResponsavel.length : 0} corretor(es)`;

      // 2. Os 4 Grupos Separados
      const reconf = diff.cardsPreexistentesReconfirmados !== undefined 
        ? diff.cardsPreexistentesReconfirmados 
        : Math.max(0, (diff.cardsReconfirmados || 0) - (diff.novosLeads ? diff.novosLeads.length : 0) - (diff.novasParticipacoes ? diff.novasParticipacoes.length : 0));
      const preserv = diff.cardsPreexistentesPreservados !== undefined 
        ? diff.cardsPreexistentesPreservados 
        : (diff.cardsPreservadosNaoReconfirmados || 0);

      document.getElementById('sync-diff-preexistentes-reconf').innerText = reconf;
      document.getElementById('sync-diff-preservados').innerText = preserv;
      document.getElementById('sync-diff-novos-leads').innerText = diff.novosLeads ? diff.novosLeads.length : 0;
      document.getElementById('sync-diff-novas-partic').innerText = diff.novasParticipacoes ? diff.novasParticipacoes.length : 0;

      // 3. Detalhamento Expansível
      const detalhesContainer = document.getElementById('sync-diff-detalhes');
      let html = '';

      if (diff.novosLeads && diff.novosLeads.length > 0) {
        html += '<div class="mb-2 text-blue-900 font-bold">🆕 Novos Clientes Cadastrados (&lt; 60 dias):</div>';
        diff.novosLeads.forEach(n => {
          html += `<div class="pl-2 mb-1 text-gray-700">• <b>${n.nome}</b> (ID ${n.lead_id}) — Funil: ${n.funil_nome} | Etapa: ${n.etapa_nome} | Corretor: ${n.corretor_nome}</div>`;
        });
      }

      if (diff.novasParticipacoes && diff.novasParticipacoes.length > 0) {
        html += '<div class="mt-2 mb-1 text-indigo-900 font-bold">➕ Novas Participações em Outro Funil (Cliente já existente):</div>';
        diff.novasParticipacoes.forEach(p => {
          html += `<div class="pl-2 mb-1 text-gray-700">• <b>${p.nome}</b> (ID ${p.lead_id}) — Entrou no Funil: <b>${p.funil_nome}</b> (Etapa: ${p.etapa_nome})</div>`;
        });
      }

      if (diff.mudancasEtapa && diff.mudancasEtapa.length > 0) {
        html += '<div class="mt-2 mb-1 text-purple-900 font-bold">🔄 Mudanças de Etapa Detectadas no CRM:</div>';
        diff.mudancasEtapa.forEach(m => {
          html += `<div class="pl-2 mb-1 text-gray-700">• <b>${m.nome}</b> (ID ${m.lead_id} - ${m.funil_nome}): <span class="text-gray-500">${m.de_etapa}</span> ➔ <b class="text-purple-700 font-bold">${m.para_etapa}</b></div>`;
        });
      }

      if (diff.mudancasResponsavel && diff.mudancasResponsavel.length > 0) {
        html += '<div class="mt-2 mb-1 text-cyan-900 font-bold">👤 Mudanças de Corretor Responsável:</div>';
        diff.mudancasResponsavel.forEach(r => {
          html += `<div class="pl-2 mb-1 text-gray-700">• <b>${r.nome}</b> (ID ${r.lead_id} - ${r.funil_nome}): <span class="text-gray-500">${r.de_corretor}</span> ➔ <b class="text-cyan-700 font-bold">${r.para_corretor}</b></div>`;
        });
      }

      if (diff.novosLeadsGerenciais && diff.novosLeadsGerenciais > 0) {
        html += `<div class="mt-2 mb-1 text-slate-800 font-bold">📋 Camada Gerencial de Entradas: <b>+${diff.novosLeadsGerenciais}</b> lead(s) capturado(s) (etapas inativas, outros pipelines ou sem pipeline).</div>`;
      }

      if (diff.etapasNaoConfirmadas && diff.etapasNaoConfirmadas.length > 0) {
        html += '<div class="mt-2 mb-1 text-amber-900 font-bold">⚠️ Etapas Recentes Não Confirmadas no CRM (Etapa anterior preservada):</div>';
        diff.etapasNaoConfirmadas.forEach(e => {
          html += `<div class="pl-2 mb-1 text-amber-800">• <b>${e.nome}</b> (ID ${e.lead_id} - ${e.funil_nome}): Etapa retornada ID ${e.etapa_id_desconhecido} não cadastrada no mapa oficial. Mantida: <b>${e.etapa_mantida}</b></div>`;
        });
      }

      if (diff.leadsIgnoradosLegados && diff.leadsIgnoradosLegados > 0) {
        html += '<div class="mt-2 mb-1 text-gray-600 font-bold">⏳ Leads Legados Descartados (>60 dias fora da carteira):</div>';
        html += `<div class="pl-2 mb-1 text-gray-500">• <b>${diff.leadsIgnoradosLegados}</b> lead(s) antigo(s) cadastrado(s) há mais de 60 dias não pertenciam ao painel e foram ignorados para evitar importação indevida de histórico legado.</div>`;
      }

      if (!html) {
        html = '<div class="text-gray-500 italic p-2">Nenhuma alteração detectada. Todos os cards avaliados continuam com as mesmas etapas e corretores.</div>';
      }

      detalhesContainer.innerHTML = html;
    }

    // Gravação definitiva (Passo 3 para 4) — Chamado somente após confirmação do usuário (Itens 2, 4, 6)
    async function applySyncConfirmed() {
      if (!currentSyncSessionId || checkSyncSessionExpired()) {
        alert("Esta prévia expirou. Faça uma nova consulta antes de atualizar o painel.");
        return;
      }

      const confirmMsg = "Confirma a gravação da atualização no snapshot da carteira de leads?\n\n" +
        "• Um backup automático timestamped será gerado antes da gravação.\n" +
        "• Históricos de comentários, reuniões, resumos e telefones serão 100% preservados.\n" +
        "• A gravação no disco é definitiva para a sessão ativa.";

      if (!confirm(confirmMsg)) {
        return;
      }

      const btnApply = document.getElementById('btn-apply-sync');
      btnApply.disabled = true;
      btnApply.innerHTML = `⏳ Gravando atualização com backup...`;

      try {
        const res = await fetch('/api/sync/apply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId: currentSyncSessionId, isSimulated: currentSyncIsSimulated })
        });

        if (!res.ok) {
          const errData = await res.json();
          if (errData.error && errData.error.includes("expirou")) {
            const expBanner = document.getElementById('sync-expired-banner');
            const warnBanner = document.getElementById('sync-warning-banner');
            if (expBanner) expBanner.classList.remove('hidden');
            if (warnBanner) warnBanner.classList.add('hidden');
            alert("Esta prévia expirou. Faça uma nova consulta antes de atualizar o painel.");
          } else {
            alert("Falha na gravação: " + (errData.error || 'Erro desconhecido'));
          }
          btnApply.disabled = false;
          btnApply.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> CONFIRMAR E ATUALIZAR PAINEL`;
          return;
        }

        const data = await res.json();
        syncAppliedSuccessfully = true;

        // Preenche resumo de sucesso detalhado (Item 4)
        const diff = currentSyncDiffReport || data.diffReport || {};
        const novosCount = diff.novosLeads ? diff.novosLeads.length : 0;
        const novasParticCount = diff.novasParticipacoes ? diff.novasParticipacoes.length : 0;
        const mudancasEtapaCount = diff.mudancasEtapa ? diff.mudancasEtapa.length : 0;
        const dataHoraFormatada = formatarDataHoraBr(data.baseAtualizadaEm || new Date().toISOString());

        document.getElementById('sync-success-novos-leads').innerText = novosCount;
        document.getElementById('sync-success-novas-partic').innerText = novasParticCount;
        document.getElementById('sync-success-mudancas-etapa').innerText = mudancasEtapaCount;
        document.getElementById('sync-success-data-hora').innerText = dataHoraFormatada;
        document.getElementById('sync-backup-name').innerText = data.backupFile || 'bali_test_33a_backup_*.json';

        setSyncStepper(4);
        document.getElementById('sync-step-3').classList.add('hidden');
        document.getElementById('sync-step-4').classList.remove('hidden');

        // Atualização automática das métricas e dados da tela em segundo plano (Item 4)
        await loadDashboard();

      } catch (err) {
        console.error(err);
        alert("Falha na gravação: " + err.message + "\n\nO snapshot anterior foi mantido.");
        btnApply.disabled = false;
        btnApply.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> CONFIRMAR E ATUALIZAR PAINEL`;
      }
    }

    function closeSyncModalAndReload() {
      closeSyncModal();
      loadDashboard();
    }

    // Init
    loadDashboard();
  </script>
