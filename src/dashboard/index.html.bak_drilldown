    async function loadDashboard(paramsStr = null) {
      try {
        let urlParams;
        if (paramsStr !== null) {
          urlParams = new URLSearchParams(paramsStr);
          window.history.pushState({}, '', '?' + paramsStr);
        } else {
          urlParams = new URLSearchParams(window.location.search);
        }
        
        // Aplica os selects a partir da URL se houver
        ['inicio', 'fim', 'funil', 'etapa', 'corretor'].forEach(param => {
          if (urlParams.has(param)) {
            document.getElementById(`filter-${param}`).value = urlParams.get(param);
          }
        });

        const [res, resPhones] = await Promise.all([
          fetch(`/api/metrics?${urlParams.toString()}`),
          fetch('/api/phones')
        ]);

        if (resPhones.ok) {
          try {
            telefones_cache = await resPhones.json();
          } catch(e) { console.error("Erro parsing telefones", e); }
        }

        const data = await res.json();

        if (res.ok) {
          globalMetricsData = data.metrics.funis;
          currentData = data;
          
          uiState.agenda = {};
          if (data.acompanhamentos) {
              Object.keys(data.acompanhamentos).forEach(k => {
                  if (data.acompanhamentos[k].na_pauta) uiState.agenda[k] = true;
              });
          }
          
          if (!globalOptions) { 
            globalOptions = data.opcoes; 
            populateOptions(); 
          }

          document.getElementById('meta-periodo').textContent = `Filtro Global: ${data.metrics.metadata.periodo_avaliado}`;
          if (document.getElementById('texto-base-atualizada')) {
            const dt = data.metrics.metadata.ultima_atualizacao || data.metrics.metadata.arquivo_mtime;
            document.getElementById('texto-base-atualizada').textContent = `Base atualizada em: ${formatarDataHoraBr(dt)}`;
          }
          const visaoGeral = data.metrics.visao_geral || { leads_unicos: data.metrics.geral.leads_unicos, distribuicao: {} };
          const dist = visaoGeral.distribuicao || {};

          document.getElementById('kpi-unicos').textContent = visaoGeral.leads_unicos;
          if (document.getElementById('kpi-unicos-carteira')) {
            document.getElementById('kpi-unicos-carteira').textContent = (data.metrics.carteira && data.metrics.carteira.leads_unicos !== undefined) ? data.metrics.carteira.leads_unicos : data.metrics.geral.leads_unicos;
          }
          document.getElementById('kpi-cards').textContent = (data.metrics.carteira && data.metrics.carteira.total_cards !== undefined) ? data.metrics.carteira.total_cards : data.metrics.geral.total_cards;

          renderPipelineDistribution(dist);
          
          let htmlFunnels = '';
          const funilFilter = document.getElementById('filter-funil').value || 'todos_exceto_3500';
          Object.values(data.metrics.funis).forEach(f => {
            let shouldRender = false;
            if (funilFilter === 'todos_incluindo_3500') shouldRender = true;
            else if (funilFilter === 'todos_exceto_3500') shouldRender = (f.id !== 3500);
            else shouldRender = (f.id.toString() === funilFilter);
            
            if (shouldRender) {
              htmlFunnels += `<div class="bg-white p-4 shadow rounded flex flex-col h-full">`;
              htmlFunnels += `  <div class="border-b pb-2 mb-3">`;
              htmlFunnels += `    <h4 class="font-bold text-gray-800">${f.nome}</h4>`;
              htmlFunnels += `    <p class="text-2xl text-gray-700 font-black">${f.total_cards}</p>`;
              htmlFunnels += `  </div>`;
              
              const corretoresObj = f.corretores || {};
              const sortedCorrs = Object.keys(corretoresObj).sort((a,b) => {
                 if (a === 'SEM CORRETOR') return -1;
                 if (b === 'SEM CORRETOR') return 1;
                 return corretoresObj[b] - corretoresObj[a];
              });
              
              if (sortedCorrs.length > 0) {
                 htmlFunnels += `<div class="flex flex-col gap-2">`;
                 sortedCorrs.forEach(c => {
                    const count = corretoresObj[c];
                    if (count === 0) return;
                    const displayName = c === 'SEM CORRETOR' ? 'Sem corretor' : c;
                    const bgColor = c === 'SEM CORRETOR' ? 'bg-red-50 border-red-200 text-red-800 hover:bg-red-100' : 'bg-blue-50 border-blue-100 text-blue-900 hover:bg-blue-100';
                    
