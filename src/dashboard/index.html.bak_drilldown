        let cellComentariosHtml = '';
        if (resumo.status === 'com_comentarios') {
            const dateObj = resumo.data_ultimo_comentario ? new Date(resumo.data_ultimo_comentario) : null;
            const dtUltimo = (dateObj && !isNaN(dateObj)) ? dateObj.toLocaleDateString() : 'Data não informada';
            const dtColeta = new Date(resumo.consultado_em).toLocaleString();
            cellComentariosHtml = `
               <span class="block text-xs font-bold text-blue-700">${resumo.qtd_comentarios} coment. (Global)</span>
               <span class="block text-[10px] text-gray-500">último em ${dtUltimo}</span>
