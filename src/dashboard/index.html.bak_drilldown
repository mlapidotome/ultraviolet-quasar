        } else {
            histHtml = `<div class="text-sm text-gray-500 italic mb-3">Histórico não consultado. (Ver Caso aberto com dados locais).</div>
                        <button id="btn-fetch-${c.lead_id}" onclick="fetchRealHistory(${c.lead_id}, 'btn-fetch-${c.lead_id}')" class="text-white px-3 py-1 rounded text-xs font-bold bg-indigo-600 hover:bg-indigo-700 transition shadow">
                          Consultar comentários no CRM
                        </button>`;
        }
        
        // Cache Resumo para a Tabela
